{
  "name": "nightly-build-web-toolchain",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only formatters and linters for the engine's web assets, docs, and templates.",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint:format": "oxfmt --check",
    "lint:js": "oxlint --deny-warnings",
    "lint:css": "stylelint \"engine/assets/**/*.css\" \"templates/**/*.css\"",
    "lint": "npm run lint:format && npm run lint:js && npm run lint:css",
    "test:js": "node --test \"tests/js/**/*.test.js\"",
    "test": "npm run test:js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
